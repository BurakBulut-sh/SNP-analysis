# Copy to workflow/config.env and edit.

# Paths
export REF_FASTA="/PATH/TO/Chironomus_riparius_genome.fasta"
export OUTDIR="/PATH/TO/project_out"
export ADAPTERS="/PATH/TO/adapters_all.fa"

# Tools (module names or leave empty if tools are on PATH)
export MOD_FASTQC="fastqc"
export MOD_TRIMMOMATIC="trimmomatic"
export MOD_PEAR="pear"
export MOD_BWA="bwa"
export MOD_SAMTOOLS="samtools"
export MOD_PICARD="picard"
export MOD_QUALIMAP="qualimap"
export MOD_GATK="gatk"
export MOD_BCFTOOLS="bcftools"

# Threads / resources (used by some scripts)
export THREADS=10

# GATK3 (optional legacy indel realignment)
export GATK3_JAR="/PATH/TO/GenomeAnalysisTK.jar"
export JAVA_BIN="/PATH/TO/java"

# accuMUlate
export ACCUMULATE_PARAMS_INI="/PATH/TO/params.ini"
